# Optional env fallbacks — all providers (QwenCloud, Gemini, Groq, OpenAI-compat)
# and workspace settings can be configured directly in Settings → Providers with no .env.local file.
# Run only one app process per DATA_DIR (dev or start, not both).
DATA_DIR=./data
PROJECTS_DIR=~/projects       # ~ expands to your home directory
QWEN_API_KEY=
QWEN_KEY_TYPE=auto            # auto | token_plan | standard (auto = detect sk-sp- prefix)
QWEN_REGION=ap-southeast-1    # ap-southeast-1 | cn-beijing
QWEN_WORKSPACE_ID=            # optional, standard keys only
QWEN_BASE_URL=                # optional override
TEXT_PROVIDER=qwen            # qwen | openai_compat
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
MAX_CONCURRENT_JOBS=3
JOB_POLL_INTERVAL_MS=10000
